# Development-only example. Export these values or pass them through your process
# manager; the application does not automatically source this file.
# Accepted values: development, test, production.
ENV=development
SECRET_KEY=change-me
TOKEN_HASH_KEY=change-me-token-hash-key
ALLOW_INSECURE_DEFAULT_SECRET=1
REFRESH_TOKEN_REUSE_GRACE_SECONDS=30
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_IP_RATE_LIMIT_PER_MINUTE=50
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

DATABASE_URL=sqlite+pysqlite:///./riskapp.db
AUTO_CREATE_SCHEMA=1
SYNC_PUSH_EXPUNGE_EVERY=200
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=
ENFORCE_HTTPS=0
TRUST_X_FORWARDED_PROTO=0
RISKAPP_LOG_LEVEL=INFO
RISKAPP_LOG_FORMAT=plain

# Optional create-only local bootstrap account. If the email already exists,
# startup leaves its password, active state, and superuser flag unchanged.
INITIAL_SUPERUSER_EMAIL=
INITIAL_SUPERUSER_PASSWORD=

# Client
RISKAPP_URL=http://127.0.0.1:8000
RISKAPP_ALLOW_HTTP=0
RISKAPP_EMAIL=
RISKAPP_PASSWORD=
RISKAPP_AUTO_SYNC_INTERVAL_SECONDS=60
RISKAPP_AUTO_SYNC_MAX_BACKOFF_SECONDS=300
